ENVIRONMENT=local
SERVICE_NAME=personal-growth-agent
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

MONGO_CONNECTION_URI=mongodb://localhost:27017
MONGO_DB_NAME=personal_growth_agent

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Every login code is this value and no email is sent. Remove once AWS SES is integrated.
HARDCODED_OTP=123456

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=personal-growth-agent
